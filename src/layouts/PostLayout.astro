---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { CATEGORIES } from '../lib/categories';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  relatedPosts: CollectionEntry<'posts'>[];
}

const { post, headings, relatedPosts } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags,
  summary,
  readingTime,
  image,
  faqs,
} = post.data;

const cat = CATEGORIES[category];
const coverImage = image ?? `/images/og-${category}.jpg`;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const formatDate = (d: Date) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/posts/${post.slug}/`}
  image={coverImage}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  breadcrumbs={[
    { name: '홈', url: '/' },
    { name: cat.label, url: cat.href },
    { name: title, url: `/posts/${post.slug}/` },
  ]}
  faqs={faqs}
>
  <article class="max-w-3xl mx-auto px-5 pt-10 pb-16">
    <!-- Breadcrumb -->
    <nav aria-label="브레드크럼" class="text-xs text-muted flex items-center gap-2 mb-6">
      <a href="/" class="hover:text-ink">홈</a>
      <span>/</span>
      <a href={cat.href} class="hover:text-ink font-medium text-ink">{cat.label}</a>
    </nav>

    <!-- Article Header -->
    <header class="pb-8 border-b border-line">
      <div class="flex flex-wrap items-center gap-3 text-xs text-muted mb-3">
        <span class="uppercase tracking-[0.14em] font-semibold text-ink">{cat.enLabel}</span>
        <span>&middot;</span>
        <time datetime={pubDate.toISOString()}>작성 {formatDate(pubDate)}</time>
        {updatedDate && (
          <>
            <span>&middot;</span>
            <time datetime={updatedDate.toISOString()}>수정 {formatDate(updatedDate)}</time>
          </>
        )}
        <span>&middot;</span>
        <span>예상 읽기 {readingTime}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-ink leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-sm sm:text-base text-muted leading-relaxed">
        {description}
      </p>
    </header>

    <!-- 대표이미지 (개별 지정 이미지 우선, 없으면 카테고리 기본 이미지 자동 적용) -->
    <figure class="mt-8 overflow-hidden border border-line bg-white">
      <img
        src={coverImage}
        alt={title}
        width="1200"
        height="675"
        loading="eager"
        decoding="async"
        class="w-full aspect-video object-cover block"
      />
    </figure>

    <!-- TL;DR 핵심 요약 박스 -->
    <section
      aria-label="핵심 요약"
      class="mt-8 p-5 bg-white border-l-2 border-ink border-y border-r border-line"
    >
      <p class="text-[11px] font-bold tracking-[0.16em] uppercase text-ink mb-2">
        KEY SUMMARY
      </p>
      <p class="text-sm text-ink/90 leading-relaxed">{summary}</p>
    </section>

    <!-- 자동 목차 (TOC) -->
    {tocHeadings.length > 0 && (
      <nav aria-label="목차" class="mt-6 p-5 bg-white border border-line">
        <p class="text-[11px] font-bold tracking-[0.16em] uppercase text-muted mb-3">
          TABLE OF CONTENTS
        </p>
        <ul class="space-y-2 text-sm">
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? 'pl-4 text-muted' : 'font-medium text-ink'}>
              <a href={`#${h.slug}`} class="hover:underline underline-offset-4">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- 마크다운 본문 -->
    <div class="prose prose-neutral max-w-none mt-10 prose-headings:tracking-tight prose-headings:text-ink prose-h2:text-xl prose-h2:sm:text-2xl prose-h2:border-b prose-h2:border-line prose-h2:pb-2 prose-h2:mt-12 prose-a:text-ink prose-a:underline prose-a:underline-offset-4 prose-p:leading-relaxed prose-li:leading-relaxed">
      <slot />
    </div>

    <!-- FAQ 섹션 (JSON-LD와 100% 동기화) -->
    {faqs.length > 0 && (
      <section aria-label="자주 묻는 질문" class="mt-14 pt-10 border-t border-ink">
        <h2 class="text-lg font-bold tracking-tight text-ink mb-5">
          자주 묻는 질문 (FAQ)
        </h2>
        <div class="divide-y divide-line border-y border-line bg-white">
          {faqs.map((faq) => (
            <details class="group p-5">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-sm sm:text-base text-ink">
                <span>Q. {faq.question}</span>
                <span class="text-muted text-lg leading-none group-open:rotate-45 transition-transform">
                  +
                </span>
              </summary>
              <p class="mt-3 text-sm text-muted leading-relaxed pl-0 sm:pl-4">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- 태그 및 상위 아카이브 복귀 링크 -->
    <div class="mt-10 pt-6 border-t border-line flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="text-xs text-muted bg-white border border-line px-2.5 py-1">
            #{tag}
          </span>
        ))}
      </div>
      <a
        href={cat.href}
        class="text-xs font-semibold tracking-[0.12em] uppercase text-ink hover:underline underline-offset-4"
      >
        &larr; {cat.label} 전체 보기
      </a>
    </div>

    <!-- 리서치 데스크 필자 카드 (E-E-A-T 시그널) -->
    <aside class="mt-10 p-5 bg-white border border-line flex flex-col gap-1.5">
      <p class="text-[11px] font-bold tracking-[0.16em] uppercase text-muted">
        EDITORIAL RESEARCH DESK
      </p>
      <p class="text-sm font-bold text-ink">레플다있다 아카이브 편집부</p>
      <p class="text-xs text-muted leading-relaxed">
        가죽 원단 특성, 하이엔드 브랜드별 연식·각인 변천사, 봉제 및 하드웨어 공정 데이터를 바탕으로
        객관적인 비교 분석 자료를 발행합니다.
      </p>
    </aside>

    <!-- 관련 아티클 (내부 링크 강화) -->
    {relatedPosts.length > 0 && (
      <section class="mt-14 pt-8 border-t border-line">
        <h2 class="text-xs font-bold tracking-[0.16em] uppercase text-ink mb-5">
          RELATED ARTICLES
        </h2>
        <div class="grid gap-4 sm:grid-cols-3">
          {relatedPosts.map((rp) => (
            <a
              href={`/posts/${rp.slug}/`}
              class="p-4 bg-white border border-line hover:border-ink transition-colors flex flex-col justify-between gap-3"
            >
              <span class="text-sm font-semibold text-ink leading-snug line-clamp-3">
                {rp.data.title}
              </span>
              <span class="text-[11px] text-muted">
                {formatDate(rp.data.pubDate)}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>