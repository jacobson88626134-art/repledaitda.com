---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../lib/categories';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const cat = CATEGORIES[post.data.category];
const formattedDate = post.data.pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class="group py-7 border-b border-line flex flex-col gap-2.5">
  <div class="flex items-center gap-3 text-[11px] tracking-[0.12em] uppercase text-muted">
    <a href={cat.href} class="text-ink font-semibold hover:underline">
      {cat.enLabel}
    </a>
    <span aria-hidden="true">/</span>
    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true">&middot;</span>
    <span>읽기 {post.data.readingTime}</span>
  </div>

  <h2 class="text-xl md:text-2xl font-bold tracking-tight text-ink leading-snug">
    <a href={`/posts/${post.slug}/`} class="group-hover:underline underline-offset-4">
      {post.data.title}
    </a>
  </h2>

  <p class="text-sm text-muted leading-relaxed line-clamp-2">
    {post.data.description}
  </p>

  {post.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 pt-1">
      {post.data.tags.slice(0, 4).map((tag) => (
        <span class="text-[11px] text-muted bg-white border border-line px-2 py-0.5">
          #{tag}
        </span>
      ))}
    </div>
  )}
</article>