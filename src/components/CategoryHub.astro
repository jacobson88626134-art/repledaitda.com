---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { CATEGORIES, CATEGORY_LIST, type CategoryKey } from '../lib/categories';

interface Props {
  categoryKey: CategoryKey;
}

const { categoryKey } = Astro.props;
const meta = CATEGORIES[categoryKey];

const posts = (
  await getCollection('posts', ({ data }) => data.category === categoryKey)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const itemList = posts.map((p) => ({
  name: p.data.title,
  url: `/posts/${p.slug}/`,
}));
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.href}
  type="collection"
  breadcrumbs={[
    { name: '홈', url: '/' },
    { name: meta.label, url: meta.href },
  ]}
  itemList={itemList}
>
  <section class="border-b border-line bg-white">
    <div class="max-w-5xl mx-auto px-5 py-14 md:py-20">
      <p class="text-[11px] font-semibold tracking-[0.22em] uppercase text-muted mb-3">
        CATEGORY ARCHIVE / {meta.enLabel}
      </p>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-ink leading-tight">
        {meta.title}
      </h1>
      <p class="mt-4 max-w-2xl text-sm md:text-base text-muted leading-relaxed">
        {meta.intro}
      </p>

      <!-- 다른 아카이브 빠른 이동 (내부 링크 강화) -->
      <div class="mt-8 flex flex-wrap gap-2">
        {CATEGORY_LIST.map((c) => (
          <a
            href={c.href}
            class:list={[
              'text-xs px-3.5 py-1.5 border transition-colors',
              c.key === categoryKey
                ? 'bg-ink text-white border-ink font-medium'
                : 'bg-paper text-muted border-line hover:border-ink hover:text-ink',
            ]}
          >
            {c.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-5 py-8">
    <div class="flex items-center justify-between pb-4 border-b border-ink">
      <h2 class="text-xs font-bold tracking-[0.16em] uppercase text-ink">
        PUBLISHED ARTICLES ({posts.length})
      </h2>
      <span class="text-xs text-muted">최신순</span>
    </div>

    {posts.length > 0 ? (
      <div>
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <div class="py-16 text-center border-b border-line">
        <p class="text-sm text-muted">아직 발행된 리서치 칼럼이 없습니다. 곧 첫 아티클이 업데이트됩니다.</p>
      </div>
    )}
  </section>
</BaseLayout>